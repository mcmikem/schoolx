# =============================================
# SKOOLMATE OS - Local Development Environment
# Copy to .env.local and fill in your values
# .env.local is in .gitignore - NEVER commit real secrets
# =============================================
#
# STRATEGY: Single Supabase for dev + production.
# Point your dev server at your LIVE Supabase so there's
# no drift between local and production databases.
# =============================================

# -- Supabase (USE YOUR LIVE SUPABASE - same as production)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -- PayPal (generate at: https://developer.paypal.com)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=YOUR_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=

# -- App
NEXT_PUBLIC_APP_NAME=SkoolMate OS
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_ENABLED=true
CRON_SECRET=generate-a-strong-random-secret-here

# -- Dev routes (never enable in production)
ENABLE_DEV_TEST_ROUTES=true
NEXT_PUBLIC_ENABLE_DEV_TEST_ROUTES=true
DEMO_ADMIN_PASSWORD=skoolmate_demo_2024

# -- Stripe (optional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# STRIPE_PRICE_LIFETIME=price_...

# -- SMS (Africa's Talking)
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=

# -- Email (SMTP - for receipts, password reset, welcome emails)
# Use Gmail App Password (16 chars) or your provider's SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="SkoolMate OS" <your-email@gmail.com>

# -- Flutterwave (Mobile Money)
# FLUTTERWAVE_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_SECRET=

# -- SchoolPay
# SCHOOLPAY_SCHOOL_CODE=
# SCHOOLPAY_API_PASSWORD=

# -- WhatsApp Business (optional)
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# -- Sentry (optional)
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_DSN=

# -- Node environment
NODE_ENV=development