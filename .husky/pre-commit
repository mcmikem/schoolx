#!/usr/bin/env sh
echo "🔒 Running pre-commit checks..."

# ============================================================================
# LOCKDOWN CHECK — Block unapproved changes to critical auth files
# ============================================================================
# To bypass: set ALLOW_AUTH_CHANGES=1 environment variable
#   ALLOW_AUTH_CHANGES=1 git commit -m "fix: auth changes"
# ============================================================================

LOCKED_FILES=(
  "src/lib/auth-context.tsx"
  "src/lib/auth-context-types.ts"
  "src/lib/auth-login.ts"
  "src/lib/auth-phone.ts"
  "src/lib/auth-demo.ts"
  "src/lib/supabase-lock.ts"
  "src/lib/useSessionTimeout.ts"
  "src/lib/validation.ts"
  "src/proxy.ts"
  "src/app/login/page.tsx"
  "src/app/register/page.tsx"
  "src/app/auth/callback/route.ts"
  "src/app/api/auth/me/route.ts"
  "src/app/api/auth/otp/route.ts"
  "src/app/api/auth/verify-otp/route.ts"
  "src/app/api/register/route.ts"
  "src/app/api/register/oauth/route.ts"
  "src/app/api/demo-login/route.ts"
  "src/app/api/forgot-password/route.ts"
  "src/app/api/reset-password/route.ts"
  "src/components/onboarding/OnboardingFlow.tsx"
  "src/components/onboarding/PostOnboardingSetup.tsx"
  "src/__tests__/lockdown.test.ts"
  "src/__tests__/regression.test.ts"
)

LOCKED_PATTERN=""
for f in "${LOCKED_FILES[@]}"; do
  if [ -z "$LOCKED_PATTERN" ]; then
    LOCKED_PATTERN="$f"
  else
    LOCKED_PATTERN="$LOCKED_PATTERN|$f"
  fi
done

STAGED_LOCKED=$(git diff --cached --name-only | grep -E "^($LOCKED_PATTERN)$" || true)

if [ -n "$STAGED_LOCKED" ]; then
  if [ "$ALLOW_AUTH_CHANGES" != "1" ]; then
    echo ""
    echo "🔒 LOCKED FILES MODIFIED — Changes blocked!"
    echo ""
    echo "The following critical auth files were modified:"
    echo "$STAGED_LOCKED" | while read -r file; do
      echo "  • $file"
    done
    echo ""
    echo "These files are locked to prevent accidental breakage."
    echo "To proceed, you MUST:"
    echo "  1. Run: npm test -- --testPathPatterns=lockdown"
    echo "  2. Run: npm run test:regression"
    echo "  3. Verify all tests pass"
    echo "  4. Commit with: ALLOW_AUTH_CHANGES=1 git commit -m \"your message\""
    echo ""
    echo "If you did not intend to modify these files, revert them:"
    echo "  git restore --staged $STAGED_LOCKED"
    echo ""
    exit 1
  else
    echo "  ⚠️  ALLOW_AUTH_CHANGES=1 — Skipping lockdown check"
  fi
fi

echo "🔒 Running pre-commit checks..."

echo "  [1/3] Auto-formatting and linting staged files..."
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx)$' | tr '\n' ' ' || true)
if [ -n "$STAGED_TS" ]; then
  npx biome format --write $STAGED_TS 2>&1 > /dev/null
  npx biome lint $STAGED_TS 2>&1
  if [ $? -ne 0 ]; then
    echo "❌ Lint failed. Fix errors before committing."
    exit 1
  fi
  git add $STAGED_TS
fi
echo "  ✅ Lint passed"

echo "  [2/3] TypeScript type check..."
npm run typecheck --silent 2>&1
if [ $? -ne 0 ]; then
  echo "❌ TypeScript failed. Fix type errors before committing."
  exit 1
fi
echo "  ✅ TypeScript passed"

echo "  [3/3] Regression tests..."
npm run test:regression --silent 2>&1 | tail -n 5
if [ ${PIPESTATUS[0]} -ne 0 ]; then
  echo "❌ Regression tests failed. Fix before committing."
  exit 1
fi
echo "  ✅ Regression tests passed"

echo "✅ All checks passed. Committing..."
