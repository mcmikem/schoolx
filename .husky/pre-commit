#!/usr/bin/env sh
echo "🔒 Running pre-commit checks..."

# ============================================================================
# LOCKDOWN CHECK — Block unapproved changes to critical auth files
# ============================================================================
# To bypass: set ALLOW_AUTH_CHANGES=1 environment variable
#   ALLOW_AUTH_CHANGES=1 git commit -m "fix: auth changes"
# ============================================================================

LOCKED_FILES=(
  "src/lib/auth-context.tsx"
  "src/lib/auth-context-types.ts"
  "src/lib/auth-login.ts"
  "src/lib/auth-phone.ts"
  "src/lib/auth-demo.ts"
  "src/lib/supabase-lock.ts"
  "src/lib/useSessionTimeout.ts"
  "src/lib/validation.ts"
  "src/proxy.ts"
  "src/app/login/page.tsx"
  "src/app/register/page.tsx"
  "src/app/auth/callback/route.ts"
  "src/app/api/auth/me/route.ts"
  "src/app/api/auth/otp/route.ts"
  "src/app/api/auth/verify-otp/route.ts"
  "src/app/api/register/route.ts"
  "src/app/api/register/oauth/route.ts"
  "src/app/api/demo-login/route.ts"
  "src/app/api/forgot-password/route.ts"
  "src/app/api/reset-password/route.ts"
  "src/components/onboarding/OnboardingFlow.tsx"
  "src/components/onboarding/PostOnboardingSetup.tsx"
  "src/__tests__/lockdown.test.ts"
  "src/__tests__/regression.test.ts"
)

LOCKED_PATTERN=""
for f in "${LOCKED_FILES[@]}"; do
  if [ -z "$LOCKED_PATTERN" ]; then
    LOCKED_PATTERN="$f"
  else
    LOCKED_PATTERN="$LOCKED_PATTERN|$f"
  fi
done

STAGED_LOCKED=$(git diff --cached --name-only | grep -E "^($LOCKED_PATTERN)$" || true)
AUTH_FILES_CHANGED=0

if [ -n "$STAGED_LOCKED" ]; then
  AUTH_FILES_CHANGED=1
  if [ "$ALLOW_AUTH_CHANGES" != "1" ]; then
    echo ""
    echo "🔒 LOCKED FILES MODIFIED — Changes blocked!"
    echo ""
    echo "The following critical auth files were modified:"
    echo "$STAGED_LOCKED" | while read -r file; do
      echo "  • $file"
    done
    echo ""
    echo "These files are locked to prevent accidental breakage."
    echo "To proceed, you MUST:"
    echo "  1. Run: npm run test:auth"
    echo "  2. Verify every auth, lockdown and regression test passes"
    echo "  3. Commit with: ALLOW_AUTH_CHANGES=1 git commit -m \"your message\""
    echo ""
    echo "If you did not intend to modify these files, revert them:"
    echo "  git restore --staged $STAGED_LOCKED"
    echo ""
    exit 1
  else
    echo "  ⚠️  ALLOW_AUTH_CHANGES=1 — Skipping lockdown check"
  fi
fi

echo "🔒 Running pre-commit checks..."

# ============================================================================
# SECRET SCAN — refuse to commit credentials
# ============================================================================
# A public Supabase service_role key was committed to this repository's history
# in April 2026, so this check exists to make that class of mistake loud rather
# than silent. It only inspects staged content, which keeps it fast (~0.4s).
#
# Install gitleaks if it is missing:  brew install gitleaks
# ============================================================================

if command -v gitleaks >/dev/null 2>&1; then
  echo "  [1/4] Secret scan (staged)..."
  if ! gitleaks git --staged --redact --no-banner --log-level error; then
    echo ""
    echo "❌ Secret detected in staged changes. Commit blocked."
    echo ""
    echo "Do NOT commit this. Instead:"
    echo "  1. Remove the secret and load it from the environment instead."
    echo "  2. If it was ever pushed, rotate/revoke it — removing it later does not undo exposure."
    echo ""
    exit 1
  fi
  echo "  ✅ No secrets in staged changes"
else
  echo "  ⚠️  gitleaks not installed — skipping secret scan (brew install gitleaks)"
fi

echo "  [2/4] Auto-formatting and linting staged files..."
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx)$' | tr '\n' ' ' || true)
if [ -n "$STAGED_TS" ]; then
  # husky runs this hook with `set -e`, so a non-zero exit here aborts the whole
  # commit. Formatting is best-effort here; the lint gate below is what blocks.
  npx biome format --write $STAGED_TS > /dev/null 2>&1 || true
  # biome exits non-zero both for lint errors and when every path handed to it
  # is ignored by its config (next-env.d.ts, for one). Treating the latter as a
  # failure blocks commits that touch only such files, so check the message.
  # `|| LINT_STATUS=$?` keeps `set -e` from aborting on the assignment itself,
  # which propagates the command substitution's status.
  LINT_STATUS=0
  LINT_OUTPUT=$(npx biome lint $STAGED_TS 2>&1) || LINT_STATUS=$?
  if [ $LINT_STATUS -ne 0 ] && ! echo "$LINT_OUTPUT" | grep -q "No files were processed"; then
    echo "$LINT_OUTPUT"
    echo "❌ Lint failed. Fix errors before committing."
    exit 1
  fi
  git add $STAGED_TS
fi
echo "  ✅ Lint passed"

echo "  [3/4] TypeScript type check..."
npm run typecheck --silent 2>&1
if [ $? -ne 0 ]; then
  echo "❌ TypeScript failed. Fix type errors before committing."
  exit 1
fi
echo "  ✅ TypeScript passed"

if [ "$AUTH_FILES_CHANGED" = "1" ]; then
  echo "  [4/4] Auth contract tests (locked file changed)..."
  npm run test:auth --silent 2>&1 | tail -n 8
  if [ ${PIPESTATUS[0]} -ne 0 ]; then
    echo "❌ Auth contract tests failed. Fix before committing."
    exit 1
  fi
  echo "  ✅ Auth contract tests passed"
else
  echo "  [4/4] Regression tests..."
  npm run test:regression --silent 2>&1 | tail -n 5
  if [ ${PIPESTATUS[0]} -ne 0 ]; then
    echo "❌ Regression tests failed. Fix before committing."
    exit 1
  fi
  echo "  ✅ Regression tests passed"
fi

# ============================================================================
# BREAKING CHANGE CHECK — Detect changes that could break customers
# ============================================================================
# Checks for:
# - Removed API endpoints
# - Removed route parameters
# - Changed environment variable requirements
# - Removed feature flags
# ============================================================================

echo ""
echo "  [5/5] Breaking change detection..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR || true)

# Check for removed API routes
REMOVED_API_ROUTES=$(echo "$STAGED_FILES" | grep -E 'src/app/api/.*/route\.ts$' || true)
if [ -n "$REMOVED_API_ROUTES" ]; then
  echo ""
  echo "⚠️  API routes modified - verify no endpoints were removed:"
  echo "$REMOVED_API_ROUTES" | while read -r file; do
    echo "  • $file"
  done
  echo ""
  echo "   If you removed an API endpoint, ensure backward compatibility or"
  echo "   add a deprecation notice before committing."
fi

# Check for removed environment variable usage
REMOVED_ENV_VARS=$(git diff --cached | grep -E 'process\.env\.' | grep -E '^-.*process\.env\.' || true)
if [ -n "$REMOVED_ENV_VARS" ]; then
  echo ""
  echo "⚠️  Environment variables removed from code - ensure they're not required:"
  echo "$REMOVED_ENV_VARS" | while read -r line; do
    echo "  • $line"
  done
fi

# Check for console.log in production code (should use logger)
CONSOLE_LOGS=$(git diff --cached | grep -E 'console\.(log|error|warn|info)' | grep -v '__tests__' || true)
if [ -n "$CONSOLE_LOGS" ]; then
  echo ""
  echo "⚠️  console.log/warn/error found in staged changes - use logger.ts instead:"
  echo "$CONSOLE_LOGS" | while read -r line; do
    echo "  • $line"
  done
fi

echo "✅ Breaking change detection complete"

echo ""
echo "✅ All checks passed. Committing..."
