{
  "name": "schoolx",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write --unsafe src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "knip": "knip",
    "analyze": "ANALYZE=true npm run build",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:regression": "jest --runInBand --testPathPatterns=regression",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:roles:teacher-bursar": "PLAYWRIGHT_USE_EXISTING_SERVER=true playwright test tests/e2e/dashboard-authenticated.spec.ts -g \"bursar can open finance actions on fees page|teacher can open teacher dashboard and sub-pages\" --workers=1",
    "check:env": "node scripts/check-env-readiness.mjs",
    "check:production-leakage": "node scripts/check-production-leakage.mjs",
    "check:release": "npm run lint && npm run typecheck && npm run test:regression && npm run build && npm run check:production-leakage",
    "scan-events:retention": "node scripts/scan-events-retention.mjs",
    "pre-commit": "npm run lint --silent && npm run typecheck --silent && npm test --silent",
    "health": "node scripts/health-check.mjs",
    "check:ci": "node scripts/check-ci.mjs",
    "check:ci:watch": "node scripts/check-ci.mjs --watch",
    "check:routes": "node scripts/route-health.mjs",
    "repair:missing-user-profiles": "node scripts/repair-missing-user-profiles.mjs",
    "audit:uiux": "node scripts/audit-uiux.mjs",
    "audit:uiux:strict": "node scripts/audit-uiux.mjs --strict",
    "cap:init": "cap init \"SkoolMate OS\" com.skoolmate.os --web-dir=out",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "build:mobile": "MOBILE_BUILD=1 npm run build",
    "build:android": "MOBILE_BUILD=1 npm run build && npx cap sync android",
    "build:ios": "MOBILE_BUILD=1 npm run build && npx cap sync ios",
    "dev:android": "npx cap run android --livereload --external",
    "dev:ios": "npx cap run ios --livereload --external",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose -f docker-compose.yml up -d",
    "docker:prod:build": "docker compose -f docker-compose.yml up -d --build",
    "docker:logs": "docker compose -f docker-compose.yml logs -f",
    "docker:stop": "docker compose -f docker-compose.yml down",
    "docker:clean": "docker compose -f docker-compose.yml down -v --rmi local",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/keyboard": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@google/genai": "^1.46.0",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@sentry/nextjs": "^10.47.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@tanstack/react-query": "^5.100.10",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.14.0",
    "next": "^16.2.2",
    "nodemailer": "^8.0.7",
    "papaparse": "^5.5.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-to-print": "^3.3.0",
    "recharts": "^3.8.0",
    "stripe": "^21.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@jest/globals": "^30.3.0",
    "@next/bundle-analyzer": "^16.2.2",
    "@playwright/test": "^1.59.1",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "knip": "^6.26.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3"
  }
}
