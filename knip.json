{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/app/**/{page,layout,route,proxy}.{ts,tsx}", "src/lib/**/*.ts"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": [],
  "ignoreBinaries": [],
  "rules": {
    "duplicates": "warn",
    "optionalPeerDependencies": "off"
  }
}
